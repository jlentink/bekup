{
  "Config": {
    "Hostname": "bekup-run",
    "Domainname": "",
    "User": "999:999",
    "AttachStdin": true,
    "AttachStdout": true,
    "AttachStderr": true,
    "Tty": false,
    "OpenStdin": true,
    "StdinOnce": true,
    "Env": [
      "HOME=/tmp",
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "TZ=UTC",
      "PGPASSFILE=/tmp/bekup/pgpass",
      "PGSYSCONFDIR=/tmp/bekup",
      "PGSERVICEFILE=/tmp/bekup/pg_service.conf",
      "PSQLRC=/dev/null",
      "PSQL_HISTORY=/dev/null",
      "MYSQL_HISTFILE=/dev/null",
      "MYSQL_TEST_LOGIN_FILE=/dev/null"
    ],
    "Cmd": [
      "mysql",
      "--defaults-file=/tmp/bekup/my.cnf",
      "--protocol=TCP",
      "--host=mysql.example.com",
      "--port=3306",
      "--user=backup",
      "--ssl-mode=VERIFY_IDENTITY",
      "--ssl-ca=/tmp/bekup/ca.pem",
      "--tls-version=TLSv1.2,TLSv1.3",
      "--system-command=OFF",
      "--commands=OFF",
      "--local-infile=0",
      "--default-character-set=utf8mb4",
      "--database=app"
    ],
    "Healthcheck": {
      "Test": [
        "NONE"
      ]
    },
    "Image": "mysql@sha256:<catalog-digest>",
    "Volumes": null,
    "WorkingDir": "/tmp",
    "Entrypoint": [
      "/bin/sh",
      "-c",
      "set -eu\numask 077\nd=/tmp/bekup\nfail() { printf 'bekup-preamble: %s\\n' \"$1\" \u003e\u00262; exit 97; }\nmkdir -m 700 \"$d\" 2\u003e/dev/null || fail 'cannot create the preamble directory'\nIFS= read -r line || fail 'missing header'\n[ \"$line\" = 'BEKUP-PREAMBLE 1' ] || fail 'bad header'\nn=0\nwhile :; do\n  IFS= read -r line || fail 'truncated preamble'\n  [ \"$line\" = 'END' ] \u0026\u0026 break\n  n=$((n + 1))\n  [ \"$n\" -le 5 ] || fail 'too many records'\n  t=${line%% *}\n  len=${line#* }\n  [ \"$t $len\" = \"$line\" ] || fail 'bad record header'\n  case $len in ''|*[!0-9]*|0?*) fail 'bad record length' ;; esac\n  [ \"${#len}\" -le 5 ] || fail 'record too large'\n  [ \"$len\" -le 65536 ] || fail 'record too large'\n  case $t in\n    pgpass) f=$d/pgpass ;;\n    mycnf) f=$d/my.cnf ;;\n    ca) f=$d/ca.pem ;;\n    clientcert) f=$d/client-cert.pem ;;\n    clientkey) f=$d/client-key.pem ;;\n    *) fail 'unknown record type' ;;\n  esac\n  [ ! -e \"$f\" ] || fail 'duplicate record'\n  IFS= read -r line || fail 'truncated record'\n  case $line in *[!A-Za-z0-9+/=]*) fail 'bad record encoding' ;; esac\n  printf '%s' \"$line\" | base64 -d \u003e\"$f\" 2\u003e/dev/null || fail 'bad record encoding'\n  [ \"$(($(wc -c \u003c\"$f\")))\" -eq \"$len\" ] || fail 'record length mismatch'\n  chmod 600 \"$f\"\ndone\nunset line t len f n\nexec \"$@\"\n",
      "--"
    ],
    "Labels": {
      "bekup.managed": "true",
      "bekup.run_id": "0b7f5a3c-2c1e-4d7a-9a51-8c3f0e6d2b19"
    },
    "StopSignal": "SIGTERM",
    "StopTimeout": 10

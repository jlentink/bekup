# Backup destinations (task 2.12; D-106, D-131; WebDAV D-222). Admins manage them; every
# change needs a fresh step-up and is audited. Maintainers see metadata only
# (name, type, mode flags, readiness; `settings` is null for them) and may
# test destinations. Credentials are write-only: inputs accept new values,
# outputs only tell whether one is stored (hasSecretAccessKey, hasPassword,
# hasPrivateKey). Destinations are soft deleted.

"Destination types."
enum DestinationType {
  DISK
  S3
  SFTP
  "WebDAV: Nextcloud, ownCloud (TransIP STACK), NAS boxes, Apache/nginx/rclone/Caddy, hosted WebDAV (D-222)."
  WEBDAV
}

"The dialect of a WebDAV server."
enum WebdavFlavor {
  "Plain WebDAV: url is the folder that holds the backups; uploads are one streaming PUT."
  GENERIC
  """
  Nextcloud or ownCloud (TransIP STACK too): url is the server address;
  files live below the user's files and large uploads use the chunked
  upload API (64 MiB chunks).
  """
  NEXTCLOUD
}

"How a WebDAV server's TLS certificate is verified."
enum WebdavTrust {
  "Against the system roots."
  SYSTEM
  "Only against the destination's CA bundle."
  CA_BUNDLE
  "Only the pinned certificate (and its key) is accepted."
  PINNED
  "No TLS at all: a plain http URL, accepted in dev mode only."
  PLAIN_HTTP
}

"What a WebDAV test recognized the server as."
enum WebdavServerKind {
  NEXTCLOUD
  OWNCLOUD
}

"How a WebDAV destination uploads."
enum WebdavUploadMode {
  "One streaming PUT."
  SINGLE
  "The Nextcloud/ownCloud chunked-upload API."
  CHUNKED
}

"The outcome of the WebDAV overwrite probe."
enum WebdavOverwriteProbe {
  "The server refuses to move a file onto an existing one ('Overwrite: F'): required."
  REFUSED
  "The server replaced the existing file: bekup never writes to it."
  IGNORED
}

"S3 Object Lock retention modes."
enum ObjectLockMode {
  GOVERNANCE
  COMPLIANCE
}

"S3 server-side encryption."
enum S3Encryption {
  NONE
  "SSE-S3 (provider-managed keys, AES256)."
  SSE_S3
  "SSE-KMS (kmsKeyId optional: the account's default key)."
  SSE_KMS
}

"How integrity checksums are sent to S3."
enum S3ChecksumMode {
  "A SHA-256 checksum with every upload (AWS S3 and compatible stores)."
  WHEN_SUPPORTED
  "Only where the protocol requires one (stores without flexible checksums)."
  WHEN_REQUIRED
}

"The credential an SFTP destination authenticates with."
enum SftpAuthMethod {
  NONE
  PASSWORD
  PRIVATE_KEY
}

"A backup destination."
type Destination {
  id: UUID!
  name: String!
  type: DestinationType!
  "True when bekup never deletes from this destination (retention is left to lifecycle rules)."
  noDelete: Boolean!
  "The S3 default Object Lock retention applied to every upload (null when off)."
  objectLockMode: ObjectLockMode
  objectLockRetentionDays: Int
  "True when the destination can be used (credentials and, for SFTP, a confirmed host key are present)."
  ready: Boolean!
  "What is missing when not ready."
  notReadyReason: String
  createdAt: Time!
  updatedAt: Time!
  "The full non-secret configuration. Admins only: null for maintainers."
  settings: DestinationSettings
  """
  The newest stored testDestination result (D-187); null when never
  tested. Normalized codes only.
  """
  lastTest: DestinationLastTest
}

"The stored outcome of the newest testDestination (D-187)."
type DestinationLastTest {
  at: Time!
  ok: Boolean!
  "The normalized error class of the first failed step (as DestinationTestStep.code); null when ok."
  code: String
  "The destination's settings changed after this test."
  stale: Boolean!
}

"Per-type settings; exactly the field of the destination's type is set."
type DestinationSettings {
  disk: DiskDestinationSettings
  s3: S3DestinationSettings
  sftp: SftpDestinationSettings
  webdav: WebdavDestinationSettings
}

type WebdavDestinationSettings {
  "The https folder URL (GENERIC) or the server address (NEXTCLOUD)."
  url: String!
  flavor: WebdavFlavor!
  username: String!
  "Folder below the URL (GENERIC) or below the user's files (NEXTCLOUD); empty: the base itself."
  path: String!
  "A custom CA bundle (PEM) that replaces the system roots (unused while a certificate is pinned)."
  caBundlePem: String
  "Timeout of one metadata request in seconds (null: 60)."
  timeoutSeconds: Int
  hasPassword: Boolean!
  "How the server certificate is verified."
  trust: WebdavTrust!
  "The pinned certificate; null until pinWebdavCertificate."
  pinnedCertificate: WebdavCertificate
}

"A WebDAV server's TLS certificate (public data)."
type WebdavCertificate {
  "SHA-256 of the certificate's public key (SPKI), lowercase hex: compare it, then pass it to pinWebdavCertificate."
  spkiSha256: String!
  "The same SPKI SHA-256 in base64."
  spkiSha256Base64: String!
  "SHA-256 of the whole certificate (DER, hex), as browsers and openssl x509 -fingerprint -sha256 show it."
  fingerprintSha256: String!
  notBefore: Time!
  notAfter: Time!
  selfSigned: Boolean!
  "When it was pinned (pinned certificates only)."
  pinnedAt: Time
}

type DiskDestinationSettings {
  "Directory below storage.disk_root."
  path: String!
}

type S3DestinationSettings {
  "The endpoint URL of an S3-compatible service; null means AWS S3."
  endpoint: String
  region: String!
  bucket: String!
  "Key prefix inside the bucket (empty: the bucket root)."
  prefix: String!
  pathStyle: Boolean!
  encryption: S3Encryption!
  kmsKeyId: String
  storageClass: String
  checksumMode: S3ChecksumMode!
  "Atomic never-overwrite with If-None-Match (disable only for stores that reject it)."
  conditionalWrites: Boolean!
  accessKeyId: String!
  hasSecretAccessKey: Boolean!
  "A custom CA bundle (PEM) that replaces the system roots for the endpoint."
  caBundlePem: String
}

type SftpDestinationSettings {
  host: String!
  port: Int!
  user: String!
  "Absolute base directory on the server."
  basePath: String!
  "Subdirectory below basePath (empty: basePath itself)."
  dir: String!
  authMethod: SftpAuthMethod!
  hasPassword: Boolean!
  hasPrivateKey: Boolean!
  hasPassphrase: Boolean!
  "The authorized_keys line of the stored private key (install it on the server)."
  publicKey: String
  "The pinned host key; null until confirmDestinationHostKey."
  hostKey: SshHostKey
}

"An SSH host key (public data)."
type SshHostKey {
  "Key type, e.g. ssh-ed25519."
  type: String!
  "OpenSSH SHA-256 fingerprint (SHA256:...)."
  fingerprintSha256: String!
  "The key as an authorized_keys line (type and base64, no comment)."
  authorizedKey: String!
  "When an admin pinned it; null for a fetched, unconfirmed key."
  confirmedAt: Time
  """
  The server the key was fetched from (fetch results only; null for a
  pinned key). Pass host and port back as expectedHost/expectedPort when
  confirming: the pin is refused (CONFLICT) if the record changed since.
  """
  host: String
  port: Int
}

"The result of testDestination: normalized codes and fixed messages only."
type DestinationTestResult {
  ok: Boolean!
  "Steps in order: connect, (WebDAV: overwrite,) write, read, delete."
  steps: [DestinationTestStep!]!
  "The probe object's key (below the destination's prefix)."
  probeKey: String
  "True when the probe object was left behind (no-delete mode, Object Lock or a failed delete)."
  probeRemains: Boolean!
  note: String
  "WebDAV destinations only: the certificate, server and upload findings of the test (null for other types)."
  webdav: WebdavTestDetails
}

"What a test of a WebDAV destination saw (fixed values and public data only)."
type WebdavTestDetails {
  trust: WebdavTrust!
  "The certificate passed the trust check."
  trusted: Boolean!
  "The certificate the server presented (null when none was seen: unreachable or plain http)."
  certificate: WebdavCertificate
  "The presented certificate's key is the pinned one."
  pinMatches: Boolean!
  "The server looks like Nextcloud or ownCloud (its status.php answered); null otherwise."
  server: WebdavServerKind
  "The flavor the server suggests (NEXTCLOUD when server is set)."
  suggestedFlavor: WebdavFlavor!
  "The upload mode the write step used; null when it did not run."
  uploadMode: WebdavUploadMode
  "The overwrite probe; null when it did not finish."
  overwriteProtection: WebdavOverwriteProbe
}

type DestinationTestStep {
  name: String!
  ok: Boolean!
  "A normalized error class (ok, permission_denied, network, timeout, ...)."
  code: String!
  message: String!
}

"The public half of a generated SSH keypair; the private key is stored encrypted and never returned."
type DestinationSshKeypair {
  destination: Destination!
  "The authorized_keys line to install on the SFTP server."
  publicKey: String!
  fingerprintSha256: String!
}

extend type Query {
  "Destinations that are not deleted, ordered by name."
  destinations: [Destination!]! @hasRole(roles: [ADMIN, MAINTAINER])

  "One destination; null when it does not exist or was deleted."
  destination(id: UUID!): Destination @hasRole(roles: [ADMIN, MAINTAINER])

  """
  Storage per destination that is not deleted, ordered by name: the bytes
  and number of the backup files bekup tracks as present there (exact; one
  aggregate, no paging).
  """
  destinationUsage: [DestinationUsage!]! @hasRole(roles: [ADMIN, MAINTAINER])

  """
  The total and free space behind a destination, where its backend reports
  it (D-225): disk (statfs), SFTP (statvfs@openssh.com), WebDAV (RFC 4331
  quota; Nextcloud/ownCloud report the account quota); never S3. Asked on
  demand through the SSRF guard and the pins, bounded in time, rate
  limited like tests and cached per destination for 5 minutes (failures 1
  minute; a settings change asks again). Fixed reasons only, never server
  text. NOT_FOUND for an unknown or deleted destination.
  """
  destinationSpace(id: UUID!): DestinationSpace! @hasRole(roles: [ADMIN, MAINTAINER])

  """
  The unrecorded files of a destination (D-209): files in bekup's layout
  (`{job slug}/{timestamp}/{file}`, older than 24 hours) that no backup
  record references, found by the daily scan. `first` is 1..200 (default
  50); `after` is `nextCursor` of the previous page. NOT_FOUND for an
  unknown or deleted destination.
  """
  destinationUnrecordedFiles(destinationId: UUID!, first: Int, after: String): UnrecordedFiles! @hasRole(roles: [ADMIN])
}

"A file in bekup's layout on a destination that no backup record references (D-209)."
type UnrecordedFile {
  id: UUID!
  "The object key below the destination root (`{job slug}/{timestamp}/{file}`)."
  key: String!
  "Size in bytes as the destination reported it."
  size: Float!
  "The modification time the destination reported (null: unknown)."
  modifiedAt: Time
  "When the daily scan first found the file."
  firstSeenAt: Time!
  "When the daily scan last found the file."
  lastSeenAt: Time!
}

"The unrecorded files of one destination (D-209)."
type UnrecordedFiles {
  destinationId: UUID!
  "When the daily scan last finished on this destination (null: never)."
  scannedAt: Time
  "Number of recorded unrecorded files."
  totalCount: Int!
  "Sum of their sizes (bytes)."
  totalBytes: Float!
  """
  The scan found more files than it records, or stopped at its object
  limit: the list is incomplete.
  """
  truncated: Boolean!
  "Empty directories the last scan removed."
  prunedDirectories: Int!
  "This page, ordered by key."
  files: [UnrecordedFile!]!
  "Pass as `after` for the next page (null: last page)."
  nextCursor: String
}

"The outcome of deleteUnrecordedFile (normalized code and fixed message only)."
type UnrecordedFileDeleteResult {
  ok: Boolean!
  "A storage error class (as DestinationTestStep.code); `ok` on success."
  code: String!
  message: String!
}

"What bekup stores on one destination."
type DestinationUsage {
  destinationId: UUID!
  name: String!
  type: DestinationType!
  "Sum of the sizes of the present backup files (bytes)."
  storedBytes: Float!
  "Number of present backup files (dumps and manifests)."
  artifactCount: Int!
  "Number of backups (runs) with present files here."
  backupCount: Int!
}

"Whether a destination's backend reported its space."
enum DestinationSpaceStatus {
  "At least one of total, free and used is known."
  AVAILABLE
  "The backend type (S3) or this server reports no space."
  UNSUPPORTED
  "The space could not be checked now (not ready, unreachable, too many checks)."
  UNAVAILABLE
}

"The space behind a destination (D-225)."
type DestinationSpace {
  destinationId: UUID!
  status: DestinationSpaceStatus!
  "A fixed explanation when status is not AVAILABLE."
  reason: String
  "The file system's (disk, SFTP) or the quota's (WebDAV) size in bytes; null when not reported."
  totalBytes: Float
  "Bytes available to bekup; null when not reported."
  freeBytes: Float
  "Bytes in use by anything (not only bekup); null when not reported."
  usedBytes: Float
  "The newest full set of backups here: per job, its newest run's present files (bytes)."
  newestSetBytes: Float!
  "The free space is below a tenth of the total or below newestSetBytes."
  low: Boolean!
  "When the backend was asked (null: not asked, e.g. S3 or not ready)."
  checkedAt: Time
}

extend type Mutation {
  """
  Creates a destination. Exactly the settings input of `type` must be
  set. A name already in use answers CONFLICT. SFTP destinations become
  ready once their host key is confirmed and a password or key is set.
  """
  createDestination(input: CreateDestinationInput!): Destination! @hasRole(roles: [ADMIN]) @stepUp

  """
  Changes a destination. A settings input replaces the whole non-secret
  configuration of its type (credential fields left out keep the stored
  value). Changing an SFTP destination's host or port removes its pinned
  host key. The location (disk path, S3 bucket and prefix, SFTP base path
  and directory) can only change while no backup files are recorded as
  present there (VALIDATION otherwise, D-209): bekup would lose track of
  them.
  """
  updateDestination(id: UUID!, input: UpdateDestinationInput!): Destination! @hasRole(roles: [ADMIN]) @stepUp

  "Soft deletes a destination (its name can be reused)."
  deleteDestination(id: UUID!): Boolean! @hasRole(roles: [ADMIN]) @stepUp

  """
  Writes, reads back and deletes a small probe object below the
  destination's prefix (no delete in no-delete mode). Rate limited; must be
  the only field of its operation.
  """
  testDestination(id: UUID!): DestinationTestResult! @hasRole(roles: [ADMIN, MAINTAINER])

  """
  Deletes one unrecorded file (D-209). Re-checked at delete time: still no
  backup record references the key, the file still exists and is older
  than 24 hours, and the destination is not in no-delete mode
  (VALIDATION / CONFLICT otherwise). Audited. Must be the only field of its
  operation.
  """
  deleteUnrecordedFile(destinationId: UUID!, id: UUID!): UnrecordedFileDeleteResult! @hasRole(roles: [ADMIN]) @stepUp

  """
  Trust on first use: connects to the stored host and port of an SFTP
  destination through the SSRF guard and returns the host key it presents,
  without authenticating. Compare the fingerprint out of band before
  confirming it. Failures are normalized (unreachable, refused address,
  unsupported key type). Rate limited; must be the only field of its
  operation.
  """
  fetchDestinationHostKey(id: UUID!): SshHostKey! @hasRole(roles: [ADMIN])

  """
  Pins the host key of an SFTP destination (an authorized_keys line).
  expectedHost/expectedPort are the host and port the key was fetched from
  (SshHostKey.host/port); CONFLICT if the destination changed since.
  """
  confirmDestinationHostKey(id: UUID!, authorizedKey: String!, expectedHost: String!, expectedPort: Int!): Destination! @hasRole(roles: [ADMIN]) @stepUp

  """
  Generates an ed25519 keypair for an SFTP destination, stores the private
  key encrypted (replacing a stored password or key) and returns only the
  public key.
  """
  generateDestinationSshKeypair(id: UUID!): DestinationSshKeypair! @hasRole(roles: [ADMIN]) @stepUp

  """
  Pins the TLS certificate a WebDAV destination's server presents (D-222):
  bekup captures it again through the SSRF guard (TLS handshake only, no
  credentials sent) and pins it only if the SHA-256 of its public key
  equals `fingerprint` (WebdavCertificate.spkiSha256 from a test, compared
  out of band; hex or base64). The certificate must name the URL's host
  and be valid now. Afterwards only this certificate is accepted (no
  system roots, no CA bundle). CONFLICT when the server now presents
  another certificate; CONNECTION_FAILED when it cannot be reached. Rate
  limited; must be the only field of its operation.
  """
  pinWebdavCertificate(id: UUID!, fingerprint: String!): Destination! @hasRole(roles: [ADMIN]) @stepUp

  """
  Removes the certificate pin of a WebDAV destination: its server is
  verified against the system roots or its CA bundle again. Audited and
  alerted.
  """
  clearWebdavCertificatePin(id: UUID!): Destination! @hasRole(roles: [ADMIN]) @stepUp
}

input CreateDestinationInput {
  name: String!
  type: DestinationType!
  "Never delete from this destination (default false)."
  noDelete: Boolean
  disk: DiskDestinationInput
  s3: S3DestinationInput
  sftp: SftpDestinationInput
  webdav: WebdavDestinationInput
}

"Fields to change; unset fields stay unchanged."
input UpdateDestinationInput {
  name: String
  noDelete: Boolean
  disk: DiskDestinationInput
  s3: S3DestinationInput
  sftp: SftpDestinationInput
  webdav: WebdavDestinationInput
}

input DiskDestinationInput {
  "Directory below storage.disk_root (relative; no '..')."
  path: String!
}

input S3DestinationInput {
  "https URL of an S3-compatible service (http only in dev mode); omit for AWS S3."
  endpoint: String
  region: String!
  bucket: String!
  prefix: String
  pathStyle: Boolean
  encryption: S3Encryption
  kmsKeyId: String
  storageClass: String
  checksumMode: S3ChecksumMode
  "Default true."
  conditionalWrites: Boolean
  "Default Object Lock retention (requires a bucket with Object Lock)."
  objectLockMode: ObjectLockMode
  objectLockRetentionDays: Int
  accessKeyId: String!
  "Write-only. Required when creating; omit to keep the stored key."
  secretAccessKey: String
  caBundlePem: String
}

input SftpDestinationInput {
  host: String!
  "Default 22."
  port: Int
  user: String!
  basePath: String!
  dir: String
  """
  Write-only; replaces a stored private key. Omit to keep the stored
  credential, except when host, port, user or basePath changes: a stored
  password must then be entered again (or replaced by a key).
  """
  password: String
  "Write-only PEM private key; replaces a stored password. Prefer generateDestinationSshKeypair."
  privateKey: String
  "Write-only; only together with privateKey."
  privateKeyPassphrase: String
}

input WebdavDestinationInput {
  """
  https URL (http only in dev mode): GENERIC the existing folder that holds
  the backups (for example https://u123.your-storagebox.de/backups);
  NEXTCLOUD the server address (for example https://cloud.example.com or
  https://name.stackstorage.com). Changing it removes the pinned
  certificate.
  """
  url: String!
  "Default GENERIC."
  flavor: WebdavFlavor
  "HTTP Basic user name (no ':')."
  username: String!
  """
  Write-only (an app password for Nextcloud/ownCloud). Omit to keep the
  stored one, except when url, flavor or username changes: it must then be
  entered again.
  """
  password: String
  "Folder below the base; created if missing."
  path: String
  "PEM CA certificates that replace the system roots."
  caBundlePem: String
  "Timeout of one metadata request in seconds (5..600; default 60)."
  timeoutSeconds: Int
}

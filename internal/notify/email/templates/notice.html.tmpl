<!DOCTYPE html>
<html lang="{{.Lang}}" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
{{.MSOHead}}
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
body{margin:0;padding:0;width:100%;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
table{border-collapse:collapse}
a{color:{{.L.Primary}}}
.mn{font-family:ui-monospace,Menlo,Consolas,monospace;white-space:nowrap}
.dt td{border-bottom:1px solid {{.L.Rule}}}
.nm{overflow-wrap:anywhere;min-width:72px}
.dt tr.nr td{border-bottom:0;padding-bottom:2px}
.dt tr td.pl{padding:1px 7px;border-bottom:0;border-radius:3px;font-size:12px;line-height:18px;white-space:nowrap}
@media only screen and (max-width:520px){
.op{padding:8px 4px!important}
.px{padding-left:16px!important;padding-right:16px!important}
.hs{display:none!important}
.fig{display:inline-block!important;width:50%!important;box-sizing:border-box}
.h1{font-size:27px!important;line-height:33px!important}
.fv{font-size:24px!important;line-height:30px!important}
.dt td,.dt th{padding-left:4px!important;padding-right:4px!important}
.dt tr td.pl{padding:1px 5px!important;font-size:11px!important;white-space:normal!important}
}
</style>
<style>
@media (prefers-color-scheme:dark){
.bg{background-color:{{.D.Bg}}!important}
.cd{background-color:{{.D.Surface}}!important;border-color:{{.D.Border}}!important}
.tx,.dt,.dl{color:{{.D.Text}}!important}
.dl th,.dl td{border-bottom-color:{{.D.Rule}}!important}
.mu{color:{{.D.Muted}}!important}
.ms{border-bottom-color:{{.D.Strong}}!important}
.dt th{border-bottom-color:{{.D.Strong}}!important;color:{{.D.Muted}}!important}
.dt td{border-bottom-color:{{.D.Rule}}!important}
.fig{border-top-color:{{.D.Text}}!important}
.hr{border-top-color:{{.D.Border}}!important}
.btn{background-color:{{.D.Primary}}!important}
.btl{color:{{.D.OnPrimary}}!important}
.lk{color:{{.D.Primary}}!important}
{{range .Levels}}.st{{.K}}{background-color:{{.D.Solid}}!important}
.b{{.K}}{background-color:{{.D.Soft}}!important;border-left-color:{{.D.Solid}}!important}
.b{{.K}} .wd,.v{{.K}},.n{{.K}}{color:{{.D.Fg}}!important}
.dt td.p{{.K}}{background-color:{{.D.Soft}}!important;color:{{.D.Fg}}!important}
.dt td.q{{.K}}{background-color:{{$.D.Surface}}!important;border-color:{{.D.Solid}}!important;color:{{.D.Fg}}!important}
{{if .Problem}}.r{{.K}} td{background-color:{{.D.Soft}}!important}
.r{{.K}} td.c1{border-left-color:{{.D.Solid}}!important}
{{end}}{{end}}}
</style>
<style>
[data-ogsc] .tx,[data-ogsc] .dt,[data-ogsc] .dl{color:{{.D.Text}}!important}
[data-ogsc] .mu{color:{{.D.Muted}}!important}
[data-ogsc] .lk{color:{{.D.Primary}}!important}
[data-ogsc] .btl{color:{{.D.OnPrimary}}!important}
[data-ogsb] .bg{background-color:{{.D.Bg}}!important}
[data-ogsb] .cd{background-color:{{.D.Surface}}!important}
[data-ogsb] .btn{background-color:{{.D.Primary}}!important}
{{range .Levels}}[data-ogsc] .b{{.K}} .wd,[data-ogsc] .v{{.K}},[data-ogsc] .n{{.K}},[data-ogsc] .p{{.K}},[data-ogsc] .q{{.K}}{color:{{.D.Fg}}!important}
[data-ogsb] .st{{.K}}{background-color:{{.D.Solid}}!important}
[data-ogsb] .b{{.K}},[data-ogsb] .dt td.p{{.K}}{background-color:{{.D.Soft}}!important}
[data-ogsb] .dt td.q{{.K}}{background-color:{{$.D.Surface}}!important}
{{if .Problem}}[data-ogsb] .r{{.K}} td{background-color:{{.D.Soft}}!important}
{{end}}{{end}}</style>
</head>
<body class="bg" style="margin:0;padding:0;background-color:{{.L.Bg}};color:{{.L.Text}};font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
{{if .Preheader}}<div style="display:none;max-height:0;max-width:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;opacity:0;color:{{.L.Bg}};">{{.Preheader}}{{.PreFill}}</div>
{{end}}<table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{.L.Bg}}" style="width:100%;background-color:{{.L.Bg}};">
<tr><td class="op" align="center" style="padding:28px 12px;">
{{.MSOOpen}}
<table role="presentation" class="cd" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{.L.Surface}}" style="width:100%;max-width:600px;background-color:{{.L.Surface}};border:1px solid {{.L.Border}};border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:{{.L.Text}};">
{{with .Banner}}<tr><td class="st{{.K}}" height="6" bgcolor="{{.S.Solid}}" style="height:6px;line-height:6px;font-size:6px;background-color:{{.S.Solid}};border-radius:7px 7px 0 0;">&nbsp;</td></tr>
{{end}}<tr><td class="px" style="padding:24px 32px 0;">
<table role="presentation" class="ms" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-bottom:3px double {{.L.Strong}};"><tr>
<td class="sr tx" style="padding:0 0 10px;font-family:'Instrument Serif',Georgia,'Times New Roman',serif;font-size:24px;line-height:28px;font-style:italic;color:{{.L.Text}};">bekup</td>
</tr></table>
</td></tr>
<tr><td class="px" style="padding:22px 32px 0;">
<h1 class="sr tx h1" style="margin:0;font-family:'Instrument Serif',Georgia,'Times New Roman',serif;font-size:32px;line-height:38px;font-weight:400;color:{{.L.Text}};">{{.Heading}}</h1>
</td></tr>
{{with .Banner}}<tr><td class="px" style="padding:18px 32px 0;">
<table role="presentation" class="b{{.K}}" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{.S.Soft}}" style="width:100%;background-color:{{.S.Soft}};border-left:4px solid {{.S.Solid}};"><tr><td style="padding:{{if .Loud}}16px 20px 17px{{else}}11px 16px 12px{{end}};">
<p class="wd" style="margin:0 0 2px;font-size:{{if .Loud}}25px{{else}}12px{{end}};line-height:{{if .Loud}}30px{{else}}16px{{end}};font-weight:800;letter-spacing:0.07em;text-transform:uppercase;color:{{.S.Fg}};">{{.Word}}</p>
<p class="tx" style="margin:0;font-size:15px;line-height:22px;color:{{$.L.Text}};">{{.Text}}</p>
</td></tr></table>
</td></tr>
{{end}}{{if .Paragraphs}}<tr><td class="px" style="padding:18px 32px 0;">
{{range .Paragraphs}}<p class="tx" style="margin:0 0 12px;font-size:15px;line-height:23px;color:{{$.L.Text}};">{{.}}</p>
{{end}}</td></tr>
{{end}}{{if .Figures}}<tr><td class="px" style="padding:10px 32px 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr>{{range .Figures}}<td class="fig" width="{{$.FigureWidth}}" valign="top" style="width:{{$.FigureWidth}};padding:12px 12px 14px 0;border-top:2px solid {{$.L.Text}};"><div class="mn fv {{.Class}}" style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:28px;line-height:34px;font-weight:600;white-space:nowrap;color:{{.Color}};">{{.Value}}{{if .Unit}}<span style="font-size:15px;line-height:1;font-weight:500;"> {{.Unit}}</span>{{end}}</div><div class="mu" style="padding-top:5px;font-size:11px;line-height:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:{{$.L.Muted}};">{{.Label}}</div></td>{{end}}</tr></table>
</td></tr>
{{end}}{{range .Tables}}<tr><td class="px" style="padding:24px 32px 0;">
<h2 class="sr tx" style="margin:0 0 6px;font-family:'Instrument Serif',Georgia,'Times New Roman',serif;font-size:22px;line-height:28px;font-weight:400;color:{{$.L.Text}};">{{.Title}}</h2>
<table class="dt" width="100%" cellpadding="8" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:14px;line-height:20px;color:{{$.L.Text}};">
<thead><tr>{{range .Head}}<th scope="col" align="{{if .Num}}right{{else}}left{{end}}" class="mn{{if .Hide}} hs{{end}}" style="padding:6px 8px;border-bottom:1px solid {{$.L.Strong}};font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;line-height:16px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;white-space:nowrap;color:{{$.L.Muted}};">{{.Text}}</th>{{end}}</tr></thead>
<tbody>
{{range $r := .Rows}}<tr{{if .Class}} class="{{.Class}}"{{end}}>{{range .Cells}}<td{{if .Num}} align="right"{{end}}{{if $r.Tint}} bgcolor="{{$r.Tint}}"{{end}}{{if .Class}} class="{{.Class}}"{{end}}{{if and $r.Tint .First}} style="border-left:4px solid {{$r.Rule}}"{{end}}>{{with .Pill}}<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="pl {{.Class}}" bgcolor="{{.Bg}}" style="{{if .Border}}border:1px solid {{.Border}};{{end}}color:{{.Fg}}"><b>{{end}}{{.Text}}{{if .Pill}}</b></td></tr></table>{{end}}</td>{{end}}</tr>
{{if .Note}}<tr{{if .Tint}} class="r{{.K}}"{{end}}>{{if .NoteCell}}<td{{if .Tint}} bgcolor="{{.Tint}}" class="c1" style="border-left:4px solid {{.Rule}}"{{end}}></td>{{end}}<td colspan="{{.NoteSpan}}"{{if .Tint}} bgcolor="{{.Tint}}"{{end}} class="{{.NoteClass}}{{if and .Tint (not .NoteCell)}} c1{{end}}" style="padding-top:0;font-size:13px;font-weight:600;color:{{.NoteColor}}{{if and .Tint (not .NoteCell)}};border-left:4px solid {{.Rule}}{{end}}">{{.Note}}</td></tr>
{{end}}{{end}}</tbody>
</table>
</td></tr>
{{end}}{{if .Details}}<tr><td class="px" style="padding:12px 32px 0;">
<table class="dl" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:14px;line-height:20px;color:{{.L.Text}};">
{{range .Details}}<tr><th scope="row" align="left" valign="top" class="mu" style="padding:7px 16px 7px 0;border-bottom:1px solid {{$.L.Rule}};font-weight:600;white-space:nowrap;color:{{$.L.Muted}};">{{.Label}}</th><td style="padding:7px 0;border-bottom:1px solid {{$.L.Rule}};word-break:break-word;">{{.Value}}</td></tr>
{{end}}</table>
</td></tr>
{{end}}{{with .Action}}<tr><td class="px" style="padding:28px 32px 0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="btn" bgcolor="{{$.L.Primary}}" style="border-radius:6px;background-color:{{$.L.Primary}};mso-padding-alt:12px 22px;"><a class="btl" href="{{.URL}}" target="_blank" style="display:inline-block;padding:12px 22px;font-size:15px;line-height:20px;font-weight:600;color:{{$.L.OnPrimary}};text-decoration:none;border-radius:6px;">{{.Label}}</a></td></tr></table>
<p class="mu" style="margin:14px 0 0;font-size:13px;line-height:19px;color:{{$.L.Muted}};">{{$.ButtonMissing}}<br><span class="lk" style="word-break:break-all;color:{{$.L.Primary}};">{{.URL}}</span></p>
</td></tr>
{{end}}<tr><td class="px" style="padding:28px 32px 28px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="hr mu" style="padding-top:14px;border-top:1px solid {{.L.Border}};font-size:12px;line-height:18px;color:{{.L.Muted}};">{{.Footer}}</td></tr></table>
</td></tr>
</table>
{{.MSOClose}}
</td></tr>
</table>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:24px;background:#f6f7f9;color:#1b1f24;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;">
<div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #d8dde3;border-radius:8px;padding:24px;">
<p style="margin:0 0 16px;font-size:13px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#4a5562;">bekup</p>
<h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">{{.Heading}}</h1>
{{range .Paragraphs}}<p style="margin:0 0 12px;">{{.}}</p>
{{end}}{{if .Details}}<table role="presentation" style="border-collapse:collapse;margin:8px 0 16px;width:100%;">
{{range .Details}}<tr><th scope="row" style="text-align:left;padding:4px 12px 4px 0;color:#4a5562;font-weight:600;vertical-align:top;white-space:nowrap;">{{.Label}}</th><td style="padding:4px 0;word-break:break-word;">{{.Value}}</td></tr>
{{end}}</table>
{{end}}{{with .Action}}<p style="margin:20px 0;"><a href="{{.URL}}" style="display:inline-block;padding:10px 18px;background:#1f5fbf;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">{{.Label}}</a></p>
<p style="margin:0 0 12px;font-size:13px;color:#4a5562;">If the button does not work, copy this address into your browser:<br><span style="word-break:break-all;">{{.URL}}</span></p>
{{end}}<hr style="border:none;border-top:1px solid #d8dde3;margin:20px 0 12px;">
<p style="margin:0;font-size:12px;color:#4a5562;">{{.Footer}}</p>
</div>
</body>
</html>

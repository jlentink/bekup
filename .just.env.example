# Local settings for `just publish` (D-202). Copy to .just.env (gitignored,
# never committed) and keep it private: chmod 0600 .just.env
#
# Only the keys below are read; the file is parsed as plain KEY=value lines
# (never sourced: no variable expansion, no commands). The environment and
# the recipe argument win over this file.

# Image repository to push to: registry host[:port]/path, lowercase, no tag,
# no digest, no scheme and no credentials (log in with `docker login`).
#BEKUP_IMAGE_REPO=registry.example.com/team/bekup

# Platforms to build, comma-separated (default: linux/amd64,linux/arm64).
#BEKUP_PLATFORMS=linux/amd64,linux/arm64

# ---------------------------------------------------------------------------
# Local configuration and secrets: never commit these.
# The annotated *.example.toml files ARE committed.
# ---------------------------------------------------------------------------
bekup.toml
runner.toml
!bekup.example.toml
!runner.example.toml
.env
.env.*
!.env.example
# Local just settings (registry for `just publish`, D-202); the example is committed.
.just.env
*.key
*.pem
*.p12
*.pfx
*.age
id_ed25519*
secrets/
/certs/
/scratch/
/data/
/.mcp.json

# ---------------------------------------------------------------------------
# A deployment directory created in the checkout by `bekup setup` (never
# commit it: it holds the deployment's state next to its secrets)
# ---------------------------------------------------------------------------
/compose.yaml
/compose.override.yaml
/reference/
/bekup-setup.json

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Go modules: group minor/patch updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules (minor/patch)"
    },
    {
      "description": "The go directive in go.mod is bumped manually",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "npm (web/): pin exact versions, group minor/patch updates",
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm (minor/patch)"
    },
    {
      "description": "Docker images are always pinned by digest",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "GitHub Actions are always pinned by commit SHA",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github actions"
    },
    {
      "description": "Major updates need explicit approval on the dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "Digest-pinned dump images in the runner catalog (internal/engine/catalog.toml)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)catalog\\.toml$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^:\"@]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "image = \"{{depName}}:{{currentValue}}@{{newDigest}}\""
    },
    {
      "description": "Tool versions annotated with '# renovate: datasource=... depName=...' in workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+:\\s*\"?(?<currentValue>v?[0-9][^\"\\s]*)\"?"
      ]
    }
  ]
}

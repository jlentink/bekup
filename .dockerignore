# Keep the build context minimal: nothing secret, nothing generated, nothing
# that would bust the cache needlessly. Allowlist style would be stricter but
# breaks `COPY . .` for new packages, so everything risky is denied here.

# Secrets, keys and local configuration (never sent to the daemon).
secrets/
certs/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.age
**/id_ed25519*
**/.env
**/.env.*
.just.env
.just.env.example
bekup.toml
runner.toml
scratch/
data/
# Native dev backups and restore staging (`just run`, possibly plaintext).
.dev-data/

# VCS, editors, agents.
.git/
.github/
.idea/
.vscode/
.claude/
.mcp.json
**/.DS_Store

# Build outputs and dependency caches (rebuilt inside the image).
bin/
dist/
tmp/
/bekup
cmd/bekup/bekup
# Local Go workspaces (the build also sets GOWORK=off).
go.work
go.work.sum
**/node_modules/
web/dist/
web/.vite/
web/coverage/
web/playwright-report/
web/test-results/
**/*.tsbuildinfo
coverage.*
*.out
*.test

# Not needed in the image. docker-compose.yml, *.example.toml and
# deploy/{postgres,traefik,nginx} ARE needed: the binary embeds them for
# `bekup setup` (embed.go, D-203). Never embed or send deploy/dev.
plans/
docs/
deploy/dev/
# The committed compose files (rendered from docker-compose.yml by `just
# gen`, D-205 amendment 3): for operators, never embedded.
deploy/compose/
docker-compose.dev.yml
docker-compose.override.yml
Dockerfile
.dockerignore
.trivyignore
